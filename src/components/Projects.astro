---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const total = String(projects.length).padStart(2, '0');
---

<section class="wrap row" id="projects">
  <aside><span class="cap">{t('projects.aside')}</span></aside>
  <div>
    <h2>{t('projects.heading')}</h2>
    {projects.map((project, index) => {
      const idx = String(index + 1).padStart(2, '0');
      return (
        <article class="proj">
          <span class="cap">{idx} / {total}</span>
          <div>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <p class="t cap">
              {project.data.tags.join(', ')}.
              {project.data.githubUrl && (
                <> <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">{t('projects.github')}</a></>
              )}
            </p>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .proj {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0 16px;
    border-top: 1px solid var(--line);
    padding: 24px 0;
  }
  .proj:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .proj h3 {
    font-weight: 500;
    font-size: 20px;
    line-height: 32px;
  }
  .proj p {
    max-width: 64ch;
    margin-top: 8px;
    line-height: 24px;
    overflow-wrap: break-word;
  }
  .proj .t {
    margin-top: 8px;
  }
  @media (max-width: 640px) {
    .proj {
      grid-template-columns: 1fr;
      gap: 6px 0;
      padding: 20px 0;
    }
  }
</style>
