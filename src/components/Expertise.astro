---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = lang === 'id' ? [
  { dt: 'Bahasa Pemrograman', dd: 'JavaScript, TypeScript, PHP, Python' },
  { dt: 'Frontend & Native', dd: 'Svelte, Astro, Native Shell (NSH)' },
  { dt: 'Backend & API', dd: 'Hono, Node.js, REST API, integrasi MikroTik' },
  { dt: 'Basis Data', dd: 'PostgreSQL (utama), MySQL, SQLite' },
  { dt: 'Perangkat Jaringan', dd: 'MikroTik, Huawei, Juniper (routing Layer 2 & Layer 3)' },
  { dt: 'Server & Virtualisasi', dd: 'Debian (bare-metal & Proxmox), DNS, Web Server' },
  { dt: 'Kontainer & Deploy', dd: 'Docker, Docker Compose, Nginx' },
  { dt: 'Otomatisasi & ML', dd: 'Alert jaringan otomatis, model ML pemilihan jalur L2' },
] : [
  { dt: 'Languages', dd: 'JavaScript, TypeScript, PHP, Python' },
  { dt: 'Frontend & Native', dd: 'Svelte, Astro, Native Shell (NSH)' },
  { dt: 'Backend & APIs', dd: 'Hono, Node.js, REST APIs, MikroTik integration' },
  { dt: 'Databases', dd: 'PostgreSQL (primary), MySQL, SQLite' },
  { dt: 'Networking', dd: 'MikroTik, Huawei, Juniper (Layer 2 & Layer 3 routing)' },
  { dt: 'Servers & Virtualization', dd: 'Debian (bare-metal & Proxmox), DNS, Web Servers' },
  { dt: 'Containers & Deploy', dd: 'Docker, Docker Compose, Nginx' },
  { dt: 'Automation & ML', dd: 'Automated network alerts, ML L2 redundant pathing' },
];
---

<section class="wrap row" id="expertise">
  <aside><span class="cap">{t('expertise.aside')}</span></aside>
  <div>
    <h2>{t('expertise.heading')}</h2>
    <dl>
      {items.map((item) => (
        <div class="kv">
          <dt>{item.dt}</dt>
          <dd>{item.dd}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  @media (max-width: 640px) {
    h2 {
      font-size: 20px;
      line-height: 28px;
      margin-bottom: 16px;
    }
  }
</style>
