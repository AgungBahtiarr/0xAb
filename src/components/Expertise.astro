---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = lang === 'id' ? [
  { dt: 'Bahasa Pemrograman', dd: 'Go, TypeScript, JavaScript, Python' },
  { dt: 'Kerangka Kerja', dd: 'Node.js, Astro, Express, Fastify' },
  { dt: 'Basis Data', dd: 'PostgreSQL, Redis, MongoDB, SQLite' },
  { dt: 'API', dd: 'REST, gRPC, WebSockets' },
  { dt: 'Sistem Operasi', dd: 'Linux: Ubuntu, Debian, RHEL' },
  { dt: 'Kontainer', dd: 'Docker dan Compose, Kubernetes (K3s)' },
  { dt: 'Server Web', dd: 'Nginx, Caddy, HAProxy' },
  { dt: 'CI/CD', dd: 'GitHub Actions, GitLab CI' },
  { dt: 'Hardening', dd: 'Kunci SSH, UFW, fail2ban, SSL dengan Certbot' },
  { dt: 'Otomatisasi', dd: 'Skrip Bash, cron' },
] : [
  { dt: 'Languages', dd: 'Go, TypeScript, JavaScript, Python' },
  { dt: 'Frameworks', dd: 'Node.js, Astro, Express, Fastify' },
  { dt: 'Data', dd: 'PostgreSQL, Redis, MongoDB, SQLite' },
  { dt: 'APIs', dd: 'REST, gRPC, WebSockets' },
  { dt: 'Operating systems', dd: 'Linux: Ubuntu, Debian, RHEL' },
  { dt: 'Containers', dd: 'Docker and Compose, Kubernetes (K3s)' },
  { dt: 'Web servers', dd: 'Nginx, Caddy, HAProxy' },
  { dt: 'CI/CD', dd: 'GitHub Actions, GitLab CI' },
  { dt: 'Hardening', dd: 'SSH keys, UFW, fail2ban, SSL with Certbot' },
  { dt: 'Automation', dd: 'Bash scripting, cron' },
];
---

<section class="wrap row" id="expertise">
  <aside><span class="cap">{t('expertise.aside')}</span></aside>
  <div>
    <h2>{t('expertise.heading')}</h2>
    <dl>
      {items.map((item) => (
        <div class="kv">
          <dt>{item.dt}</dt>
          <dd>{item.dd}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  @media (max-width: 640px) {
    h2 {
      font-size: 20px;
      line-height: 28px;
      margin-bottom: 16px;
    }
  }
</style>
