---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProfiles = await getCollection('profile');
let profileEntry = allProfiles.find(p => p.id === `${lang}/about`);
if (!profileEntry) {
  profileEntry = allProfiles.find(p => p.id === 'en/about') || allProfiles[0];
}
const profile = profileEntry?.data;

const githubHandle = profile?.github ? `@${profile.github.split('/').filter(Boolean).pop()}` : '@AgungBahtiarr';
const twitterHandle = profile?.twitter ? `@${profile.twitter.split('/').filter(Boolean).pop()}` : '@agungberkah12';
const linkedinHandle = profile?.linkedin ? profile.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\/(in\/)?/, 'in/').replace(/\/+$/, '') : 'in/0xab';
---

<section class="wrap row" id="contact">
  <aside><span class="cap">{t('contact.aside')}</span></aside>
  <div>
    <h2>{t('contact.heading')}</h2>
    <p class="prose">{t('contact.desc')}</p>
    <dl style="margin-top: 32px">
      {profile?.email && (
        <div class="kv">
          <dt>{t('contact.email')}</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
      )}
      {profile?.linkedin && (
        <div class="kv">
          <dt>{t('contact.linkedin')}</dt>
          <dd><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{linkedinHandle}</a></dd>
        </div>
      )}
      {profile?.github && (
        <div class="kv">
          <dt>{t('contact.github')}</dt>
          <dd><a href={profile.github} target="_blank" rel="noopener noreferrer">{githubHandle}</a></dd>
        </div>
      )}
      {profile?.twitter && (
        <div class="kv">
          <dt>{t('contact.twitter')}</dt>
          <dd><a href={profile.twitter} target="_blank" rel="noopener noreferrer">{twitterHandle}</a></dd>
        </div>
      )}
      <div class="kv">
        <dt>{t('contact.location')}</dt>
        <dd>{t('contact.locationVal')}</dd>
      </div>
      <div class="kv">
        <dt>{t('contact.availability')}</dt>
        <dd>{t('contact.availabilityVal')}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .prose {
    max-width: 64ch;
  }
</style>
