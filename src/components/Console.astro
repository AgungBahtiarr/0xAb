---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProfiles = await getCollection('profile');
let profileEntry = allProfiles.find(p => p.id === `${lang}/about`);
if (!profileEntry) {
  profileEntry = allProfiles.find(p => p.id === 'en/about') || allProfiles[0];
}
const profile = profileEntry?.data;

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const projectTitles = sortedProjects.map(p => p.data.title).join('\n');
---

<section class="wrap row" id="console">
  <aside><span class="cap">{t('console.aside')}</span></aside>
  <div>
    <h2>{t('console.heading')}</h2>
    <div 
      class="term" 
      id="term"
      data-name={profile?.name || "Agung Bahtiar"}
      data-role={profile?.role || "Software Engineer"}
      data-subrole={profile?.subRole || "System Admin"}
      data-email={profile?.email || ""}
      data-github={profile?.github || "https://github.com/AgungBahtiarr"}
      data-linkedin={profile?.linkedin || "https://www.linkedin.com/in/0xab/"}
      data-twitter={profile?.twitter || "https://x.com/agungberkah12"}
      data-projects={projectTitles}
    >
      <div class="bar cap">
        <span>tty1</span>
        <span class="desktop-hint">{t('console.hint')}</span>
        <span class="mobile-hint">// type help</span>
      </div>
      <div id="out" role="log" aria-live="polite">{t('console.welcome')}
</div>
      <label class="in">
        <span class="mute">guest@0xab:~$</span>
        <input id="cmd" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label={t('console.inputAria')} />
      </label>
    </div>
  </div>
</section>

<style>
  h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .term {
    border: 1px solid var(--line);
    cursor: text;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  .term .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 4px 16px;
    gap: 8px;
    min-width: 0;
  }
  #out {
    height: 320px;
    overflow: auto;
    padding: 16px;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    font-family: inherit;
    line-height: 22px;
  }
  .in {
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--line);
    padding: 8px 16px;
    min-width: 0;
    max-width: 100%;
  }
  .in input {
    flex: 1;
    min-width: 0;
    width: 100%;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    outline: 0;
  }
  .in:focus-within {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .mobile-hint {
    display: none;
  }
  @media (max-width: 640px) {
    .desktop-hint {
      display: none;
    }
    .mobile-hint {
      display: inline;
      font-size: 11px;
    }
    #out {
      height: 180px;
      padding: 12px;
      font-size: 13px;
      line-height: 20px;
    }
    .term .bar {
      padding: 4px 12px;
      font-size: 11px;
    }
    .in {
      padding: 8px 12px;
    }
    .in input {
      font-size: 16px; /* Prevents auto-zoom on iOS Safari */
    }
  }
</style>

<script is:inline>
(function () {
  var term = document.getElementById("term");
  var out = document.getElementById("out");
  var cmd = document.getElementById("cmd");
  var tb = document.getElementById("theme");
  var R = document.documentElement;
  var themes = ["light", "ivory", "dark"];

  if (!term || !out || !cmd) return;

  var pData = term.dataset;
  var history = [];
  var hIdx = -1;

  function curTheme() {
    return R.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  }

  function setPaper(t) {
    R.dataset.theme = t;
    if (tb) tb.textContent = t[0].toUpperCase() + t.slice(1);
    try { localStorage.setItem("theme", t); } catch (e) {}
  }

  function say(s) {
    out.appendChild(document.createTextNode(s + "\n"));
    out.scrollTop = out.scrollHeight;
  }

  var C = {
    help: function () {
      return "help      list commands\nwhoami    who runs this server\nabout     brief overview\nskills    technical competencies\nstack     languages and tools\nprojects  what I built\nneofetch  server diagnostic\ncontact   where to find me\nemail     primary email\ntheme X   light, ivory or dark\nclear     empty the screen";
    },
    whoami: function () {
      return (pData.name || "Agung Bahtiar") + ", " + (pData.role || "software engineer") + " and " + (pData.subrole || "system administrator") + ".";
    },
    about: function () {
      return (pData.name || "Agung Bahtiar") + " [" + (pData.role || "Software Engineer") + " & " + (pData.subrole || "System Admin") + "]\nI build performant backend systems and design reliable, automated server environments.";
    },
    skills: function () {
      return "Go, TypeScript, JavaScript, Python\nNode.js, Astro, Express, Fastify\nPostgreSQL, Redis, MongoDB, SQLite\nLinux (Ubuntu, Debian, RHEL), Docker, K3s, Nginx";
    },
    stack: function () {
      return "Go, TypeScript, JavaScript, Python\nPostgreSQL, Redis, MongoDB, SQLite\nLinux, Docker, K3s, Nginx, Caddy, HAProxy\nGitHub Actions, GitLab CI, AWS, GCP, DigitalOcean";
    },
    projects: function () {
      return pData.projects || "0xProxy Gateway\nKubeWatch Dashboard\nShellVault CLI\nLogSieve Aggregator";
    },
    neofetch: function () {
      return "  .____   ___ _____\n  |  _ \\ / _ \\_   _|\n  | | | | | | || |\n  | |_| | |_| || |\n  |____/ \\___/ |_|\nOS:      Astro Linux x86_64\nHost:    " + (pData.name || "Agung Bahtiar") + " Portfolio (0xab.my.id)\nUptime:  99.9% stable\nShell:   bash 5.2-interactive\nTheme:   " + curTheme();
    },
    contact: function () {
      var lines = [];
      if (pData.linkedin) lines.push("LinkedIn  " + pData.linkedin);
      if (pData.github) lines.push("GitHub    " + pData.github);
      if (pData.twitter) lines.push("X         " + pData.twitter);
      return lines.join("\n");
    },
    email: function () {
      return pData.email ? "Email: " + pData.email : "Email not configured.";
    },
    theme: function (a) {
      if (themes.indexOf(a) < 0) return "Usage: theme light, ivory or dark.";
      setPaper(a);
      return "Paper set to " + a + ".";
    },
    clear: function () {
      out.textContent = "";
      return "";
    }
  };

  cmd.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      cmd.blur();
      return;
    }
    if (e.ctrlKey && e.key.toLowerCase() === "l") {
      e.preventDefault();
      C.clear();
      return;
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      if (hIdx > 0) {
        hIdx--;
        cmd.value = history[hIdx];
      }
      return;
    }
    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (hIdx < history.length - 1) {
        hIdx++;
        cmd.value = history[hIdx];
      } else {
        hIdx = history.length;
        cmd.value = "";
      }
      return;
    }
    if (e.key !== "Enter") return;

    var v = cmd.value.trim();
    cmd.value = "";
    if (!v) return;

    if (history[history.length - 1] !== v) {
      history.push(v);
    }
    hIdx = history.length;

    say("guest@0xab:~$ " + v);
    var p = v.split(/\s+/);
    var f = C[p[0].toLowerCase()];
    var r = f ? f(p[1]) : "Command not found: " + p[0] + ". Type help to list commands.";
    if (r) say(r);
  });

  term.addEventListener("click", function () {
    if (!window.getSelection().toString()) {
      cmd.focus();
    }
  });
})();
</script>
