---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const enUrl = lang === 'en' ? currentPath : currentPath.replace(/^\/id/, '') || '/';
const idUrl = lang === 'id' ? currentPath : `/id${currentPath}`;
---

<header>
  <div class="wrap">
    <a class="brand" href={translatePath('#top')}>Agung Bahtiar</a>
    <nav aria-label="Sections">
      <a href={translatePath('#about')}>{t('nav.about')}</a>
      <a href={translatePath('#expertise')}>{t('nav.expertise')}</a>
      <a href={translatePath('#projects')}>{t('nav.projects')}</a>
      <a href={translatePath('#console')}>{t('nav.console')}</a>
      <a href={translatePath('/blog')}>{t('nav.blog')}</a>
      <a href={translatePath('#contact')}>{t('nav.contact')}</a>
    </nav>
    <div class="ctl">
      <span class="cap" id="clock" aria-label={t('header.clockAria')}>WIB --:--</span>
      <span class="cap lang-toggle" aria-label="Language">
        <a href={enUrl} class={lang === 'en' ? 'active-lang' : 'mute'}>EN</a>
        <span class="mute">/</span>
        <a href={idUrl} class={lang === 'id' ? 'active-lang' : 'mute'}>ID</a>
      </span>
      <button id="theme" type="button" aria-label={t('header.changePaper')}>Light</button>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  header .wrap {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 48px;
  }
  header .brand {
    font-weight: 500;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: none;
  }
  .ctl {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang-toggle {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .lang-toggle a {
    text-decoration: none;
  }
  .lang-toggle a.active-lang {
    font-weight: 500;
    color: var(--ink);
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 1px solid var(--line);
    padding: 0 12px;
    height: 32px;
    cursor: pointer;
  }
  button:hover {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 760px) {
    header .wrap {
      flex-wrap: wrap;
      gap: 0 16px;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .ctl {
      margin-left: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 16px;
      overflow-x: auto;
      white-space: nowrap;
      padding-top: 4px;
    }
  }
</style>

<script is:inline>
(function () {
  var R = document.documentElement;
  var themes = ["light", "ivory", "dark"];
  var tb = document.getElementById("theme");

  function cur() {
    return R.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  }

  function setT(t) {
    R.dataset.theme = t;
    if (tb) tb.textContent = t[0].toUpperCase() + t.slice(1);
    try {
      localStorage.setItem("theme", t);
    } catch (e) {}
  }

  if (tb) {
    tb.textContent = cur()[0].toUpperCase() + cur().slice(1);
    tb.onclick = function () {
      setT(themes[(themes.indexOf(cur()) + 1) % 3]);
    };
  }

  var ck = document.getElementById("clock");
  function tick() {
    try {
      if (ck) {
        ck.textContent = "WIB " + new Intl.DateTimeFormat("en-GB", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
          timeZone: "Asia/Jakarta"
        }).format(new Date());
      }
    } catch (e) {}
  }
  tick();
  setInterval(tick, 15000);
})();
</script>
