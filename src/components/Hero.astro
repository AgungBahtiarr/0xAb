---
import { getCollection } from 'astro:content';
import DitherBackground from './DitherBackground.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allProfiles = await getCollection('profile');
let profileEntry = allProfiles.find(p => p.id === `${lang}/about`);
if (!profileEntry) {
  profileEntry = allProfiles.find(p => p.id === 'en/about') || allProfiles[0];
}
const profile = profileEntry?.data;

const roleHeading = lang === 'id'
  ? "Software engineer dan admin sistem Linux"
  : "Software engineer & Linux sysadmin";
const tagline = profile?.tagline || (lang === 'id'
  ? "Membangun sistem backend Go dan Node.js yang cepat, server Linux terotomatisasi, dan aplikasi web yang bersih di AWS, GCP, dan DigitalOcean."
  : "Building fast Go and Node.js backend systems, automated Linux servers, and clean web applications across AWS, GCP, and DigitalOcean.");
---

<div class="hero-wrapper">
  <DitherBackground />
  <section class="wrap hero">
    <div class="hero-main">
      <p class="status cap"><i></i>{t('hero.status')}</p>
      <h1 id="name">{roleHeading}</h1>
      <p class="lead">{tagline}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={translatePath('#contact')}>{t('hero.ctaPrimary')}</a>
        <a class="btn btn--secondary" href={translatePath('#projects')}>{t('hero.ctaSecondary')}</a>
      </div>
    </div>
    <ul class="reads" aria-label={t('hero.readsAria')}>
      <li>{t('hero.reads.uptime')}</li>
      <li>{t('hero.reads.languages')}</li>
      <li>{t('hero.reads.clouds')}</li>
    </ul>
  </section>
</div>

<style>
  .hero-wrapper {
    position: relative;
  }
  .hero {
    min-height: calc(100svh - 57px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-top: 72px;
    padding-bottom: 48px;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 640px) {
    .hero {
      min-height: calc(100svh - 57px);
      gap: 32px;
      padding-top: 36px;
      padding-bottom: 32px;
    }
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .status i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink);
    background: var(--ink);
    display: inline-block;
    flex-shrink: 0;
  }
  h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    font-size: clamp(32px, 6vw, 68px);
    line-height: 1.08;
    max-width: 18ch;
    word-break: break-word;
  }
  .lead {
    max-width: 60ch;
    margin-top: 24px;
    color: var(--ink);
    font-size: 17px;
    line-height: 28px;
  }
  @media (max-width: 640px) {
    .lead {
      font-size: 16px;
      line-height: 26px;
      margin-top: 16px;
    }
  }
  .reads {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .reads li {
    padding: 20px 16px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--mute);
  }
  .reads li + li {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }
  @media (max-width: 760px) {
    .reads {
      grid-template-columns: 1fr;
    }
    .reads li {
      padding: 12px 0;
      border-top: 1px solid var(--line);
    }
    .reads li:first-child {
      border-top: none;
    }
    .reads li + li {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
