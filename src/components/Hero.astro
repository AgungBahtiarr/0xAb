---
import { getCollection } from 'astro:content';
import DitherBackground from './DitherBackground.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allProfiles = await getCollection('profile');
let profileEntry = allProfiles.find(p => p.id === `${lang}/about`);
if (!profileEntry) {
  profileEntry = allProfiles.find(p => p.id === 'en/about') || allProfiles[0];
}
const profile = profileEntry?.data;

const roleHeading = lang === 'id'
  ? "Software Engineer & Network Engineer"
  : "Software Engineer & Network Engineer";
const tagline = profile?.tagline || (lang === 'id'
  ? "Membangun aplikasi web dengan Svelte, Astro, dan Hono, serta mengelola jaringan L2/L3 dan server Debian di atas MikroTik, Huawei, dan Juniper."
  : "Building web applications with Svelte, Astro, and Hono, alongside reliable L2/L3 networks and Debian servers across MikroTik, Huawei, and Juniper.");
---

<div class="hero-wrapper">
  <DitherBackground />
  <section class="wrap hero">
    <div class="hero-main">
      <p class="status cap"><i></i>{t('hero.status')}</p>
      <h1 id="name">{roleHeading}</h1>
      <p class="lead">{tagline}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={translatePath('#contact')}>{t('hero.ctaPrimary')}</a>
        <a class="btn btn--secondary" href={translatePath('#projects')}>{t('hero.ctaSecondary')}</a>
      </div>
    </div>
    <ul class="reads" aria-label={t('hero.readsAria')}>
      <li>{t('hero.reads.uptime')}</li>
      <li>{t('hero.reads.languages')}</li>
      <li>{t('hero.reads.clouds')}</li>
    </ul>
  </section>
</div>

<style>
  .hero-wrapper {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 57px - env(safe-area-inset-top, 0px));
    display: flex;
    flex-direction: column;
  }
  .hero {
    flex: 1;
    width: 100%;
    min-height: calc(100svh - 57px - env(safe-area-inset-top, 0px));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(20px, 4svh, 48px);
    padding-top: clamp(24px, 6svh, 72px);
    padding-bottom: clamp(20px, 4.5svh, 48px);
    position: relative;
    z-index: 1;
  }
  .hero-main {
    margin-top: auto;
    margin-bottom: auto;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(12px, 2svh, 20px);
  }
  .status i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink);
    background: var(--ink);
    display: inline-block;
    flex-shrink: 0;
  }
  h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    font-size: clamp(28px, min(6vw, 7.2svh), 68px);
    line-height: 1.08;
    max-width: 18ch;
    word-break: break-word;
  }
  .lead {
    max-width: 60ch;
    margin-top: clamp(14px, 2.4svh, 24px);
    color: var(--ink);
    font-size: clamp(15px, 1.8vw, 17px);
    line-height: clamp(24px, 2.8vw, 28px);
  }
  .hero :global(.btn-row) {
    margin-top: clamp(18px, 3.2svh, 32px);
  }
  .reads {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .reads li {
    padding: clamp(12px, 2svh, 20px) 16px 0 0;
    font-size: clamp(13px, 1.4vw, 14px);
    line-height: 21px;
    color: var(--mute);
  }
  .reads li + li {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }
  @media (max-width: 760px) {
    .reads {
      grid-template-columns: 1fr;
    }
    .reads li {
      padding: 10px 0;
      border-top: 1px solid var(--line);
    }
    .reads li:first-child {
      border-top: none;
    }
    .reads li + li {
      border-left: none;
      padding-left: 0;
    }
  }
  @media (max-width: 640px) {
    .hero {
      gap: 20px;
      padding-top: 24px;
      padding-bottom: 20px;
    }
    h1 {
      font-size: clamp(26px, 7.5vw, 40px);
    }
  }
</style>
