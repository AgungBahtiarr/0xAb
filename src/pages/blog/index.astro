---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allPosts = await getCollection('blog', ({ data, id }) => {
  return data.draft !== true && id.startsWith('en/');
});

const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog // 0xAb - Agung Bahtiar" description="Writing about backend engineering, automation, system administration, and modern web development.">
  <Header />
  
  <main id="top">
    <section class="wrap row">
      <aside>
        <span class="cap">// 0XAB LOGS</span>
        <div class="mt-4">
          <a href={translatePath('/')} class="cap">&larr; {t('blog.backToPortfolio')}</a>
        </div>
      </aside>

      <div>
        <h1 class="page-title">{t('blog.title')}</h1>
        <p class="mute prose-lead">{t('blog.desc')}</p>

        <div class="posts-list">
          {posts.length === 0 ? (
            <p class="mute cap py-8">{t('blog.noPosts')}</p>
          ) : (
            posts.map((post) => {
              const postSlug = post.id.replace(/^en\//, '');
              const postDate = post.data.pubDate.toISOString().slice(0, 10);
              return (
                <article class="post-item">
                  <div class="cap post-date">{postDate}</div>
                  <div>
                    <h2 class="post-title">
                      <a href={translatePath(`/blog/${postSlug}`)}>{post.data.title}</a>
                    </h2>
                    <p class="mute post-desc">
                      {post.data.description}
                    </p>
                    <div class="post-meta cap">
                      <span class="tags">
                        {post.data.tags.map((tag) => `#${tag}`).join(' ')}
                      </span>
                      <a href={translatePath(`/blog/${postSlug}`)} class="read-link">
                        {t('blog.readLog')} &rarr;
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          )}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .page-title {
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .prose-lead {
    max-width: 64ch;
    margin-bottom: 40px;
  }
  .posts-list {
    border-top: 1px solid var(--line);
  }
  .post-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .post-item:first-of-type {
    border-top: 0;
  }
  .post-date {
    padding-top: 4px;
  }
  .post-title {
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .post-desc {
    max-width: 64ch;
    margin-top: 8px;
    line-height: 24px;
  }
  .post-meta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .read-link {
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .page-title {
      font-size: 24px;
      line-height: 32px;
    }
    .post-item {
      grid-template-columns: 1fr;
      gap: 8px 0;
      padding: 24px 0;
    }
  }
</style>
