---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const englishPosts = posts.filter(post => post.id.startsWith('en/'));
  return englishPosts.map(post => ({
    params: { id: post.id.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
---

<Layout title={`${post.data.title} // 0xAb Blog`} description={post.data.description}>
  <Header />
  
  <main id="top">
    <article class="wrap row">
      <aside>
        <span class="cap">// 0XAB LOG</span>
        <div class="mt-4">
          <a href={translatePath('/blog')} class="cap">&larr; {lang === 'id' ? 'Daftar Log' : 'All logs'}</a>
        </div>
        <div class="post-sidebar-meta">
          <div class="cap mute">DATE</div>
          <div class="cap text-ink">{formattedDate}</div>
          <div class="cap mute mt-4">TAGS</div>
          <div class="cap text-ink">{post.data.tags.map((t: string) => `#${t}`).join(' ')}</div>
        </div>
      </aside>

      <div>
        <header class="article-header">
          <h1 class="article-title">{post.data.title}</h1>
          <p class="mute article-lead">{post.data.description}</p>
        </header>

        <div class="article-content">
          <Content />
        </div>
      </div>
    </article>
  </main>
  
  <Footer />
</Layout>

<style>
  .post-sidebar-meta {
    margin-top: 32px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .article-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 32px;
    margin-bottom: 32px;
  }
  .article-title {
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .article-lead {
    max-width: 64ch;
    margin-top: 16px;
    font-size: 15px;
    line-height: 24px;
  }
  .article-content {
    max-width: 68ch;
    line-height: 26px;
  }
  .article-content :global(h2) {
    font-weight: 500;
    font-size: 20px;
    line-height: 28px;
    margin-top: 40px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }
  .article-content :global(h3) {
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .article-content :global(p) {
    margin-bottom: 20px;
  }
  .article-content :global(ul) {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 20px;
    padding-left: 8px;
  }
  .article-content :global(ol) {
    list-style-type: decimal;
    list-style-position: inside;
    margin-bottom: 20px;
    padding-left: 8px;
  }
  .article-content :global(li) {
    margin-bottom: 6px;
  }
  .article-content :global(code) {
    font-family: inherit;
    font-size: 13px;
    padding: 2px 6px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .article-content :global(pre) {
    padding: 16px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    overflow-x: auto;
    margin: 24px 0;
    font-size: 13px;
    line-height: 20px;
  }
  .article-content :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
  }
  @media (max-width: 640px) {
    .article-title {
      font-size: 26px;
      line-height: 34px;
    }
  }
</style>
